FROM node:22-alpine
WORKDIR /app
RUN corepack enable

# pnpm e dependências são baixados no BUILD da imagem (que tem rede),
# assim o container em runtime não precisa acessar o registry npm.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY packages/core/package.json packages/core/
COPY packages/ficha-app/package.json packages/ficha-app/
COPY packages/tema/package.json packages/tema/
RUN pnpm install --frozen-lockfile --filter @calafrio/web...

ENV NODE_ENV=development
EXPOSE 3001
CMD ["pnpm", "--filter", "@calafrio/web", "dev", "--hostname", "0.0.0.0"]

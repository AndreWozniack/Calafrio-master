DOMAIN=calafrio.localhost
HOST_PORT=3001
NODE_ENV=development

# === BANCO DE DADOS POSTGRESQL (PostgreSQL 18) ===
# Local (dentro do docker dev com postgres:18-alpine): postgresql://calafrio:calafrio_secret@db:5432/calafrio
# Local (fora do docker / rodando no Mac): postgresql://calafrio:calafrio_secret@localhost:5434/calafrio
# Remoto / VPS (dokploy-network): postgresql://usuario:senha@postgres-service:5432/calafrio_prod
DATABASE_URL=postgresql://calafrio:calafrio_secret@localhost:5434/calafrio

# === ARMAZENAMENTO DE IMAGENS / RETRATOS (CLOUDFLARE R2 / S3) ===
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=sua_access_key_aqui
R2_SECRET_ACCESS_KEY=sua_secret_key_aqui
R2_BUCKET_NAME=calafrio-assets
R2_PUBLIC_URL=https://assets.seudominio.com

# === AUTENTICAÇÃO (GOOGLE OAUTH & AUTH.JS V5) ===
# Gere com: openssl rand -base64 33
AUTH_SECRET=calafrio_segredo_super_secreto_para_auth_js
# Obtenha no Google Cloud Console (OAuth 2.0 Client ID)
AUTH_GOOGLE_ID=seu_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=seu_google_client_secret
# Email do administrador (opcional)
ADMIN_EMAIL=admin@seudominio.com
# Allowlist de emails permitidos (separados por vírgula; deixe vazio para liberar geral)
EMAILS_PERMITIDOS=
# Permitir login de dev sem senha (apenas se precisar em staging/testes)
ALLOW_DEV_LOGIN=true

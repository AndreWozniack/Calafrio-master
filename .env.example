DOMAIN=calafrio.localhost
HOST_PORT=3001
NODE_ENV=development

# === BANCO DE DADOS POSTGRESQL ===
# Local (dentro do docker dev): postgresql://calafrio:calafrio_secret@db:5432/calafrio
# Local (fora do docker / rodando no Mac): postgresql://calafrio:calafrio_secret@localhost:5434/calafrio
# Remoto / VPS (dokploy-network): postgresql://usuario:senha@postgres-service:5432/calafrio_prod
DATABASE_URL=postgresql://calafrio:calafrio_secret@localhost:5434/calafrio

# === ARMAZENAMENTO DE IMAGENS / RETRATOS (CLOUDFLARE R2 / S3) ===
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=sua_access_key_aqui
R2_SECRET_ACCESS_KEY=sua_secret_key_aqui
R2_BUCKET_NAME=calafrio-assets
R2_PUBLIC_URL=https://assets.seudominio.com
